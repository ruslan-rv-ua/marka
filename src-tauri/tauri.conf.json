{
  "productName": "marka",
  "version": "0.1.0",
  "identifier": "com.marka.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm vite:dev",
    "beforeBuildCommand": "pnpm vite:build"
  },
  "app": {
    "windows": [
      {
        "title": "Marka",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src asset: http://asset.localhost https: data: blob:; media-src asset: http://asset.localhost https: blob:; style-src 'self' 'unsafe-inline';",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "cli": {
      "description": "Marka — швидкий перегляд Markdown файлів",
      "args": [
        {
          "name": "file",
          "index": 1,
          "takesValue": true,
          "description": "Шлях до .md файлу"
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md"],
        "description": "Markdown файл"
      }
    ]
  }
}
